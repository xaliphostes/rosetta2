// Expanded (reflection-free) nanobind backend. Included by inline/generate.hxx
// after backends/nanobind.h and backends/python.h (whose qualify_std()
// it reuses), plus the shared render helpers (subst / num_str / render_meta /
// write_file).

#pragma once

namespace rosetta {
    namespace backend {
        using namespace gen_detail; // shared render / IR helpers

        // A stock-toolchain CMake: C++17, the pip `nanobind` package, the user's
        // include dir only. No clang-p2996, no -freflection, no -nostdlib++.
        constexpr std::string_view NANOBINDX_CMAKE =
            R"CMK(# Generated by rosetta::generate (expanded, reflection-free) — do not edit by hand.
# Plain nanobind: NO C++26, NO reflection, NO rosetta headers.
cmake_minimum_required(VERSION 3.18)
project({{LIB}}_binding CXX)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON){{BUILD_CONFIG}}

execute_process(
    COMMAND {{PYTHON_CMD}} -c "import sys; print(sys.executable)"
    OUTPUT_VARIABLE Python_EXECUTABLE
    OUTPUT_STRIP_TRAILING_WHITESPACE)
set(Python_EXECUTABLE "${Python_EXECUTABLE}" CACHE FILEPATH "" FORCE)

# Development.SABIModule is what defines the Python::SABIModule target, and
# nanobind silently drops a STABLE_ABI request when that target is missing
# (nanobind-config.cmake: "Stable ABI builds require CPython >= 3.12 and
# Python::SABIModule"). Without it ROSETTA_STABLE_ABI below is accepted and
# then ignored, so the module builds as cpython-3XX while the wheel is still
# tagged abi3 — exactly the mismatch the pyproject comment warns about.
# Optional, not required: PyPy and free-threaded builds have no SABI, and
# nanobind already degrades to a per-version module there.
find_package(Python {{PYTHON_MIN}} COMPONENTS Interpreter Development.Module
                                   OPTIONAL_COMPONENTS Development.SABIModule REQUIRED)

# Prefer the nanobind CMake package shipped with the pip/`nanobind` module,
# fall back to fetching a pinned release.
if(NOT nanobind_DIR)
    execute_process(
        COMMAND ${Python_EXECUTABLE} -c "import nanobind; print(nanobind.cmake_dir())"
        OUTPUT_VARIABLE nanobind_DIR
        RESULT_VARIABLE _nanobind_probe
        ERROR_QUIET
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT _nanobind_probe EQUAL 0)
        set(nanobind_DIR "")
    endif()
endif()
if(nanobind_DIR)
    find_package(nanobind CONFIG REQUIRED)
else()
    include(FetchContent)
    FetchContent_Declare(
        nanobind
        GIT_REPOSITORY https://github.com/wjakob/nanobind.git
        GIT_TAG v2.13.0)
    FetchContent_MakeAvailable(nanobind)
endif()

# Build against CPython's stable ABI, so ONE wheel serves every 3.12+
# interpreter instead of one per minor version. Off by default: it only pays
# off when packaging, and it constrains the module to the limited API. The
# generated pyproject.toml turns it on for wheel builds on 3.12+.
option(ROSETTA_STABLE_ABI "Build against CPython's stable ABI (abi3)" OFF)
if(ROSETTA_STABLE_ABI)
    nanobind_add_module({{LIB}} NB_STATIC STABLE_ABI auto_nanobind.cpp)
else()
    nanobind_add_module({{LIB}} NB_STATIC auto_nanobind.cpp)
endif()

# Only the user's headers — rosetta's include dir is deliberately absent.
target_include_directories({{LIB}} PRIVATE
    {{USER_INCLUDE}})
{{USER_LIB_BLOCK}}
# Wheel builds (scikit-build-core sets SKBUILD) package what CMake *installs*,
# so the module must be installed at the wheel root for `import {{LIB}}` to work.
install(TARGETS {{LIB}} LIBRARY DESTINATION . RUNTIME DESTINATION .)

# Convenience for the in-tree build only: drop the module next to the sources so
# it can be imported from this directory. Skipped under SKBUILD, whose build tree
# is a throw-away temp copy.
if(NOT SKBUILD)
    add_custom_command(TARGET {{LIB}} POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy
            $<TARGET_FILE:{{LIB}}>
            ${CMAKE_CURRENT_SOURCE_DIR}/$<TARGET_FILE_NAME:{{LIB}}>)
endif()
{{OUT_DIR_BLOCK}}
)CMK";

        // pyproject.toml driving the wheel build, the nanobind counterpart of
        // PYX_PYPROJECT. scikit-build-core runs the CMakeLists above unchanged.
        //
        // The override block is what makes nanobind worth packaging: on 3.12+
        // it flips ROSETTA_STABLE_ABI on and tags the wheel abi3, so a single
        // artifact covers every later CPython. The two must move together —
        // tagging abi3 without the limited-API build would produce a wheel that
        // installs on 3.13 and crashes — which is why the tag lives behind the
        // same version predicate as the define, not in the base config.
        constexpr std::string_view NANOBINDX_PYPROJECT =
            R"TOML(# Generated by rosetta::generate (expanded, reflection-free) — do not edit by hand.
# Wheel build: `./make_wheel.sh`, or `python3 -m build --wheel`.
[build-system]
requires = ["scikit-build-core>=0.10", "nanobind>=2.0"]
build-backend = "scikit_build_core.build"

[project]
name = "{{LIB}}"
version = "{{VERSION}}"
description = "Auto-generated nanobind bindings for {{LIB}}."
requires-python = "{{REQUIRES_PYTHON}}"

[tool.scikit-build]
cmake.version = ">=3.18"
cmake.build-type = "Release"
# The extension module is installed at the wheel root by CMake's install() —
# there is no Python package directory to copy alongside it.
wheel.packages = []
sdist.include = ["auto_nanobind.cpp", "CMakeLists.txt"]

# On 3.12+ build against the stable ABI and tag the wheel abi3: one wheel then
# serves every later CPython. Below 3.12 nanobind's STABLE_ABI is unavailable,
# so the wheel stays tagged for the exact interpreter that built it.
[[tool.scikit-build.overrides]]
if.python-version = ">=3.12"
wheel.py-api = "cp312"
cmake.define.ROSETTA_STABLE_ABI = "ON"
)TOML";

