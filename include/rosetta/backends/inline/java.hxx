        // ---- one handle-backed wrapper class per type ----

        inline std::string java_class(const GenContext &c, const GenClass &k) {
            std::string s = "// Generated by rosetta::generate — do not edit by hand.\n";
            s += "package " + java_pkg(c) + ";\n\n";
            s += "import com.fasterxml.jackson.core.type.TypeReference;\n\n";
            if (!k.doc.empty()) {
                s += "/** " + exposed_of(k) + " */\n";
            }
            s += "public final class " + exposed_of(k) + " implements AutoCloseable {\n";
            s += "    private static final String _t = \"" + exposed_of(k) + "\";\n";
            s += "    private int _id;\n\n";

            // Constructors, deduped by erased Java signature.
            std::vector<std::string> seen_sigs;
            auto emit_ctor = [&](const std::vector<GenParam> &ps) {
                const std::string sig = java_param_sig(ps, c);
                for (const auto &s2 : seen_sigs) {
                    if (s2 == sig) {
                        return;
                    }
                }
                seen_sigs.push_back(sig);
                const std::string names = java_arg_names(ps);
                s += "    public " + exposed_of(k) + "(" + sig + ") {\n";
                s += "        _id = Rt.newInstance(_t" + (names.empty() ? "" : ", " + names) +
                     ");\n";
                s += "    }\n\n";
            };
            if (k.is_default_constructible) {
                emit_ctor({});
            }
            for (const auto &ct : k.ctors) {
                if (!ct.empty() && java_ctor_jsonable(ct)) {
                    emit_ctor(ct);
                }
            }
            if (seen_sigs.empty()) {
                // No JSON-marshalable constructor — block construction so a broken
                // (id 0) instance can't be made.
                s += "    private " + exposed_of(k) + "() { } // no JSON-marshalable constructor\n\n";
            }

            s += "    @Override\n";
            s += "    public void close() {\n";
            s += "        if (_id > 0) { Rt.destroy(_t, _id); _id = 0; }\n";
            s += "    }\n";

            // Fields → get/set accessors.
            for (const auto &f : k.fields) {
                if (!jsonable_type(f.type)) {
                    continue;
                }
                const std::string ty  = java_sig(f.type, c);
                const std::string cap = java_cap(f.name);
                if (!f.doc.empty()) {
                    s += "\n" + java_doc(f.doc, "    ");
                }
                s += "\n    public " + ty + " get" + cap + "() {\n";
                s += "        return Rt.getField(_t, _id, \"" + f.name + "\", " +
                     java_typeref(f.type, c) + ");\n";
                s += "    }\n";
                if (!f.is_readonly) {
                    s += "    public void set" + cap + "(" + ty + " value) {\n";
                    s += "        Rt.setField(_t, _id, \"" + f.name + "\", value);\n";
                    s += "    }\n";
                }
            }

            // Methods.
            for (const auto &m : k.methods) {
                if (m.is_extension || !jsonable_method(m)) { // extensions: no member pointer
                    continue;
                }
                const std::string sig   = java_param_sig(m.params, c);
                const std::string names = java_arg_names(m.params);
                const std::string tail  = names.empty() ? "" : ", " + names;
                if (!m.doc.empty()) {
                    s += "\n" + java_doc(m.doc, "    ");
                }
                s += "\n    public " + std::string(m.is_static ? "static " : "");
                if (m.ret.kind == "void") {
                    s += "void " + m.name + "(" + sig + ") {\n";
                    s += m.is_static
                             ? "        Rt.callStaticVoid(_t, \"" + m.name + "\"" + tail + ");\n"
                             : "        Rt.callMethodVoid(_t, _id, \"" + m.name + "\"" + tail +
                                   ");\n";
                } else {
                    const std::string ret = java_sig(m.ret, c);
                    s += ret + " " + m.name + "(" + sig + ") {\n";
                    s += m.is_static
                             ? "        return Rt.callStatic(_t, \"" + m.name + "\", " +
                                   java_typeref(m.ret, c) + tail + ");\n"
                             : "        return Rt.callMethod(_t, _id, \"" + m.name + "\", " +
                                   java_typeref(m.ret, c) + tail + ");\n";
                }
                s += "    }\n";
            }

            s += "}\n";
            return s;
        }

        // ---- one Java enum per enumeration (int-valued, Jackson-friendly) ----

        inline std::string java_enum(const GenContext &c, const GenEnum &e) {
            std::string s = "// Generated by rosetta::generate — do not edit by hand.\n";
            s += "package " + java_pkg(c) + ";\n\n";
            s += "import com.fasterxml.jackson.annotation.JsonCreator;\n";
            s += "import com.fasterxml.jackson.annotation.JsonValue;\n\n";
            if (!e.doc.empty()) {
                s += "/** " + exposed_of(e) + " */\n";
            }
            s += "public enum " + exposed_of(e) + " {\n";
            for (std::size_t i = 0; i < e.values.size(); ++i) {
                s += "    " + e.values[i].name + "(" + std::to_string(e.values[i].value) + ")" +
                     (i + 1 < e.values.size() ? "," : ";") + "\n";
            }
            if (e.values.empty()) {
                s += "    ;\n";
            }
            s += "\n    private final long value;\n";
            s += "    " + exposed_of(e) + "(long v) { this.value = v; }\n\n";
            s += "    @JsonValue\n";
            s += "    public long value() { return value; }\n\n";
            s += "    @JsonCreator\n";
            s += "    public static " + exposed_of(e) + " of(long v) {\n";
            s += "        for (" + exposed_of(e) + " c : values()) {\n";
            s += "            if (c.value == v) { return c; }\n";
            s += "        }\n";
            s += "        throw new IllegalArgumentException(\"invalid " + exposed_of(e) +
                 ": \" + v);\n";
            s += "    }\n";
            s += "}\n";
            return s;
        }

        // ---- free functions → a static facade ----

        inline std::string java_functions(const GenContext &c) {
            bool any = false;
            for (const auto &f : c.functions) {
                if (jsonable_function(f)) {
                    any = true;
                    break;
                }
            }
            if (!any) {
                return {};
            }
            std::string s = "// Generated by rosetta::generate — do not edit by hand.\n";
            s += "package " + java_pkg(c) + ";\n\n";
            s += "import com.fasterxml.jackson.core.type.TypeReference;\n\n";
            s += "public final class Functions {\n";
            s += "    private Functions() {}\n";
            for (const auto &f : c.functions) {
                if (!jsonable_function(f)) {
                    continue;
                }
                const std::string sig   = java_param_sig(f.params, c);
                const std::string names = java_arg_names(f.params);
                const std::string tail  = names.empty() ? "" : ", " + names;
                if (!f.doc.empty()) {
                    s += "\n" + java_doc(f.doc, "    ");
                }
                s += "\n    public static ";
                if (f.ret.kind == "void") {
                    s += "void " + f.name + "(" + sig + ") {\n";
                    s += "        Rt.callFunctionVoid(\"" + f.name + "\"" + tail + ");\n";
                } else {
                    s += java_sig(f.ret, c) + " " + f.name + "(" + sig + ") {\n";
                    s += "        return Rt.callFunction(\"" + f.name + "\", " + java_typeref(f.ret, c) +
                         tail + ");\n";
                }
                s += "    }\n";
            }
            s += "}\n";
            return s;
        }

        inline std::string jvx_class(const GenClass &k) {
            // C++ spellings use the qualified name; the registry key is the
            // exposed one, matching the Java wrapper's `_t` (manifest "expose").
            const std::string t = qualified_of(k);
            std::string       s = "    {\n        rosetta::jvm::TypeOps ops;\n";
            s += "        ops.destroy = &rosetta::jvm::destroy_inst<" + t + ">;\n";
            if (k.is_default_constructible) {
                s += "        ops.create  = &rosetta::jvm::create_default<" + t + ">;\n";
            }

            // Fields → get + (readonly / ranged / plain) set.
            for (const auto &f : k.fields) {
                if (!jsonable_type(f.type)) {
                    continue;
                }
                const std::string mp = "&" + t + "::" + f.name;
                s += "        ops.get[\"" + f.name + "\"] = &rosetta::jvm::get_field<" + mp + ">;\n";
                if (f.is_readonly) {
                    s += "        ops.set[\"" + f.name + "\"] = &rosetta::jvm::set_field_readonly<" +
                         mp + ", \"" + f.name + "\">;\n";
                } else if (f.range.has && f.type.kind == "number") {
                    s += "        ops.set[\"" + f.name + "\"] = &rosetta::jvm::set_field_ranged<" +
                         mp + ", \"" + f.name + "\", " + csx_double_lit(f.range.min) + ", " +
                         csx_double_lit(f.range.max) + ">;\n";
                } else {
                    s += "        ops.set[\"" + f.name + "\"] = &rosetta::jvm::set_field<" + mp +
                         ">;\n";
                }
            }

            // Methods → call (instance) / call_function (static; a static member
            // is a plain function pointer).
            for (const auto &m : k.methods) {
                // `ops.call` is a map keyed by the method name, so a second
                // entry for the same name overwrites the first rather than
                // adding an overload — and the host language's marshalling goes
                // through JSON, which carries no C++ types to dispatch on. Only
                // the first-declared overload binds.
                if (!coverage::emit_overload(coverage::overloads::first_only, "java", k, m)) {
                    continue;
                }
                if (m.is_extension || !jsonable_method(m)) { // extensions: no member pointer
                    coverage::note_skip("java", k, m,
                                        m.is_extension ? "extension_has_no_member_pointer"
                                                       : "unmarshalable_signature",
                                        m.is_extension
                                            ? "this backend dispatches through a member pointer, "
                                              "which an extension method does not have"
                                            : "a type in this signature has no JSON "
                                              "representation for the op table");
                    continue;
                }
                // px_member_pointer, not the bare `&T::name`: for an overloaded
                // name the bare form names the whole set, and the template
                // argument below would not compile at all. (That was true before
                // the walk started emitting every overload too — the entry that
                // reached the IR was already unbindable here.)
                const std::string mp = px_member_pointer(k, m);
                if (m.is_static) {
                    s += "        ops.scall[\"" + m.name + "\"] = &rosetta::jvm::call_function<" + mp +
                         ">;\n";
                } else {
                    s += "        ops.call[\"" + m.name + "\"] = &rosetta::jvm::call_method<" + mp +
                         ">;\n";
                }
                coverage::note_bound("java", k, m);
            }

            // Constructors → construct<T, Args...>, keyed by arity. Skip 0-arg
            // (handled by ops.create) and any whose params aren't marshalable.
            for (std::size_t i = 0; i < k.ctor_param_cpp.size(); ++i) {
                const auto &ir = k.ctors[i];
                if (ir.empty()) {
                    continue;
                }
                bool ok = true;
                for (const auto &p : ir) {
                    ok = ok && jsonable_type(p.type);
                }
                if (!ok) {
                    continue;
                }
                std::string types;
                for (const auto &spelling : k.ctor_param_cpp[i]) {
                    types += ", " + qualify_std(spelling);
                }
                s += "        ops.ctors[" + std::to_string(ir.size()) +
                     "] = &rosetta::jvm::construct<" + t + types + ">;\n";
            }

            s += "        rosetta::jvm::registry()[\"" + exposed_of(k) +
                 "\"] = std::move(ops);\n    }\n";
            return s;
        }

        inline std::string java_expanded_registrations(const GenContext &c) {
            std::string s;
            // Enums: literal name -> value map (reflection-free).
            for (const auto &e : c.enums) {
                s += "    rosetta::jvm::enums()[\"" + exposed_of(e) + "\"] = rosetta::jvm::json{";
                for (std::size_t i = 0; i < e.values.size(); ++i) {
                    s += (i ? ", " : "") + std::string("{\"") + e.values[i].name + "\", " +
                         std::to_string(e.values[i].value) + "}";
                }
                s += "};\n";
            }
            for (const auto &k : c.classes) {
                s += jvx_class(k);
            }
            for (const auto &f : c.functions) {
                if (jsonable_function(f)) {
                    coverage::note_bound_function("java", f);
                    s += "    rosetta::jvm::functions()[\"" + f.name +
                         "\"] = &rosetta::jvm::call_function<" + fn_addr(f) + ">;\n";
                } else {
                    coverage::note_skip_function("java", f, "unmarshalable_signature",
                                                 "a type in this signature has no JSON "
                                                 "marshalling");
                }
            }
            return s;
        }

        inline std::string java_expanded_source(const GenContext &c) {
            std::string out =
                "// Generated by rosetta::generate (expanded, reflection-free) — "
                "do not edit by hand.\n";
            out += "#include <rosetta/runtime/java.h>\n";
            out += "#include <cstdlib>\n#include <cstring>\n#include <mutex>\n#include <string>\n";
            // User headers (deduped) — the only thing the shim needs besides the
            // runtime; no rosetta/annotations.h (these headers are stock C++).
            auto add = [&](const std::string &h) { append_include(out, h); };
            out += init_includes(c);
            for (const auto &k : c.classes) {
                add(k.header);
            }
            for (const auto &e : c.enums) {
                add(e.header);
            }
            for (const auto &f : c.functions) {
                add(f.header);
            }
            out += using_namespaces_of(c); // `using namespace` for namespaced user types
            out += "\nnamespace {\n\nvoid register_all() {\n";
            out += java_expanded_registrations(c);
            out += "}\n";
            out += JVX_ABI;
            return out;
        }

        inline std::string Java::render(const GenContext &c) const {
            return java_expanded_source(c);
        }

        inline void Java::emit(const GenContext &c) const {
            const auto dir    = c.out_dir / "java";
            const auto srcdir = dir / "src" / "main" / "java" / java_pkgdir(c);

            // Native shim (reflection-free) + its stock-compiler build.
            write_file(dir / "auto_java.cpp", java_expanded_source(c));
            write_file(dir / "CMakeLists.txt", render_meta(JVX_CMAKE, c));

            // The Java sources / pom.xml are identical to the thin backend's —
            // same FFM protocol, same wrappers. The README only differs in the
            // backend tag and toolchain note (via {{BACKEND}} / {{TOOLCHAIN}}).
            write_file(srcdir / "Native.java", java_native(c));
            write_file(srcdir / "Rt.java", java_runtime_src(c));
            for (const auto &e : c.enums) {
                write_file(srcdir / (exposed_of(e) + ".java"), java_enum(c, e));
            }
            for (const auto &k : c.classes) {
                write_file(srcdir / (exposed_of(k) + ".java"), java_class(c, k));
            }
            const std::string fns = java_functions(c);
            if (!fns.empty()) {
                write_file(srcdir / "Functions.java", fns);
            }

            write_file(dir / "pom.xml", subst(JAVA_POM, {{"LIB", c.lib}}));
            const std::string doc =
                subst(JAVA_README,
                      {{"LIB", c.lib},
                       {"PKG", java_pkg(c)},
                       {"PKGDIR", java_pkgdir(c)},
                       {"BACKEND", "java"},
                       {"TOOLCHAIN",
                        "Builds with a stock C++20 compiler — no reflection toolchain needed."}}) +
                readme_body_of(c.classes);
            write_file(dir / "README.md", doc);
        }

