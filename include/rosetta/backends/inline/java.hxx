        constexpr std::string_view JAVA_README = R"MD(# `{{LIB}}` ({{BACKEND}})

Auto-generated Java bindings. Two pieces work together:

- **`auto_java.cpp`** → a native shared library exposing a flat C ABI
  (`rosetta_java_*`). {{TOOLCHAIN}}
- **the Java sources** (under `src/main/java/{{PKGDIR}}/`) → idiomatic wrappers.
  Each class is a handle into the native instance store; property and method
  access is a JSON round-trip through the C ABI via the Foreign Function & Memory
  API (`java.lang.foreign`), with Jackson doing the (de)serialisation.

## Build

```sh
# 1. the native library (produces lib{{LIB}}.{dylib,so} / {{LIB}}.dll)
cmake -S . -B build && cmake --build build

# 2. the Java jar
mvn package
```

## Run

The JVM must find the native library at run time. Point `java.library.path` at
the CMake build dir, and (JDK 22+) allow native access:

```sh
java --enable-native-access=ALL-UNNAMED \
     -Djava.library.path=build \
     -cp target/{{LIB}}-0.1.0.jar:$(mvn -q help:evaluate -Dexpression=settings.localRepository -DforceStdout)/com/fasterxml/jackson/... \
     {{PKG}}.Example
```

(Simpler: run from an IDE/Maven exec with `java.library.path=build`.)

## Use

```java
import {{PKG}}.*;

try (var p = new Person()) {          // AutoCloseable — frees the native instance
    p.setName("Alice");
    System.out.println(p.greet("Hi"));
}
```

Boundary types: scalars, `boolean`, `String`, enums (by value), and `List<…>`
of those. Members using any other type are omitted from both sides.

)MD";

        // -------- Java rendering helpers --------

        // Sanitise an arbitrary library name into a lower-case Java package
        // segment (letters / digits / underscore; must not start with a digit).
        inline std::string java_pkg_seg(const std::string &s) {
            auto lower = [](char ch) {
                return (ch >= 'A' && ch <= 'Z') ? char(ch - 'A' + 'a') : ch;
            };
            auto is_alnum = [](char ch) {
                return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
                       (ch >= '0' && ch <= '9');
            };
            std::string out;
            for (char ch : s) {
                out += (is_alnum(ch) ? lower(ch) : '_');
            }
            if (out.empty() || (out.front() >= '0' && out.front() <= '9')) {
                out.insert(out.begin(), '_');
            }
            return out;
        }

        // The package the generated Java lives in, and its on-disk sub-path.
        inline std::string java_pkg(const GenContext &c) {
            return "rosetta.gen." + java_pkg_seg(c.lib);
        }
        inline std::string java_pkgdir(const GenContext &c) {
            return "rosetta/gen/" + java_pkg_seg(c.lib);
        }

        // The boxed (reference) Java type — used inside generics and Jackson
        // TypeReferences. Only ever called for jsonable types.
        inline std::string java_box(const GenType &t, const GenContext &c) {
            if (t.kind == "boolean") {
                return "Boolean";
            }
            if (t.kind == "string") {
                return "String";
            }
            if (t.kind == "number") {
                return t.integer ? "Long" : "Double";
            }
            if (t.kind == "enum") {
                return t.object.empty() ? "Long" : exposed_object_of(t, c);
            }
            if (t.kind == "vector") {
                return "java.util.List<" +
                       (t.element.empty() ? std::string("Object")
                                          : java_box(t.element.front(), c)) +
                       ">";
            }
            return "Object";
        }

        // The Java type used in a method / field signature (unboxed scalars).
        inline std::string java_sig(const GenType &t, const GenContext &c) {
            if (t.kind == "boolean") {
                return "boolean";
            }
            if (t.kind == "number") {
                return t.integer ? "long" : "double";
            }
            return java_box(t, c); // String / enum / List<…> are already reference types
        }

        // A Jackson TypeReference literal capturing the (boxed) target type.
        inline std::string java_typeref(const GenType &t, const GenContext &c) {
            return "new TypeReference<" + java_box(t, c) + ">(){}";
        }

        // "double arg0, double arg1"
        // A parameter name safe to DECLARE in Java. The IR carries the
        // identifier the C++ declaration used, and `final`, `class`, `native`
        // and `synchronized` are all legal C++ parameter names and all keywords
        // here. Such a name reverts to the positional form. The declaration and
        // the forwarding call both go through this, so they cannot disagree.
        inline std::string java_ident(const std::string &name, std::size_t index) {
            static const char *kw[] = {
                "abstract","assert","boolean","break","byte","case","catch","char","class","const",
                "continue","default","do","double","else","enum","extends","false","final",
                "finally","float","for","goto","if","implements","import","instanceof","int",
                "interface","long","native","new","null","package","private","protected","public",
                "return","short","static","strictfp","super","switch","synchronized","this",
                "throw","throws","transient","true","try","var","void","volatile","while","yield",
            };
            for (const char *k : kw) {
                if (name == k) {
                    return "arg" + std::to_string(index);
                }
            }
            return name.empty() ? "arg" + std::to_string(index) : name;
        }

        // A Javadoc block. Rendered over several lines, and with any `*/` in the
        // text neutralized: a harvested comment that contains one would close
        // the block early and leave the rest of it as code.
        inline std::string java_doc(const std::string &doc, const std::string &indent) {
            if (doc.empty()) {
                return {};
            }
            std::string safe = doc;
            for (std::size_t i = safe.find("*/"); i != std::string::npos;
                 i             = safe.find("*/", i)) {
                safe.replace(i, 2, "*&#47;");
            }
            // A blank line is written as " *", not " * " — the paragraph break
            // has to survive, trailing whitespace does not.
            const auto doc_line = [&indent](std::string &o, const std::string &l) {
                o += indent + (l.empty() ? " *" : " * " + l) + "\n";
            };
            std::string out = indent + "/**\n";
            std::string line;
            for (char ch : safe) {
                if (ch == '\n') {
                    doc_line(out, line);
                    line.clear();
                    continue;
                }
                line += ch;
            }
            doc_line(out, line);
            // No trailing newline: see cs_doc — the call sites own the spacing.
            return out + indent + " */";
        }

        inline std::string java_param_sig(const std::vector<GenParam> &ps, const GenContext &c) {
            std::string s;
            for (std::size_t i = 0; i < ps.size(); ++i) {
                s += (i ? ", " : "") + java_sig(ps[i].type, c) + " " + java_ident(ps[i].name, i);
            }
            return s;
        }

        // The varargs forwarded to the Rt helpers, matching java_param_sig.
        inline std::string java_arg_names(const std::vector<GenParam> &ps) {
            std::string s;
            for (std::size_t i = 0; i < ps.size(); ++i) {
                s += (i ? ", " : "") + java_ident(ps[i].name, i);
            }
            return s;
        }

        inline bool java_ctor_jsonable(const std::vector<GenParam> &ps) {
            for (const auto &p : ps) {
                if (!jsonable_type(p.type)) {
                    return false;
                }
            }
            return true;
        }

        // Capitalise the first letter for a get/set accessor name.
        inline std::string java_cap(const std::string &s) {
            std::string out = s;
            if (!out.empty() && out.front() >= 'a' && out.front() <= 'z') {
                out.front() = char(out.front() - 'a' + 'A');
            }
            return out;
        }

